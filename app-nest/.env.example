# Application
PORT=3000

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3001

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:root@localhost:5432/pharmacy_catalog?schema=public"

# JWT — generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# In production the app REFUSES TO START while this is empty or left at the
# placeholder value below.
JWT_SECRET=change-me-to-a-strong-secret-in-production
# Short-lived access token (sent to the browser, kept in memory only).
JWT_EXPIRES_IN=15m
# Long-lived refresh token (httpOnly cookie, one row per session in the DB).
JWT_REFRESH_EXPIRES_IN=30d

# Minimum order total (USD) enforced at checkout. 0 = disabled for the demo.
MIN_ORDER_TOTAL=0

# Rate limits per client IP for /api/auth, per THROTTLE_TTL milliseconds.
# THROTTLE_LIMIT covers login and register; REFRESH_THROTTLE_LIMIT covers the
# session refresh that runs on every page load.
THROTTLE_TTL=60000
THROTTLE_LIMIT=10
REFRESH_THROTTLE_LIMIT=60
